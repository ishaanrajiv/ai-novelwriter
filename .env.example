# LM Studio (optional)
LMSTUDIO_API_KEY=

# OpenRouter (required only when provider.type=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://localhost/ai-novelwriter
OPENROUTER_APP_NAME=AI Novel Writer
OPENROUTER_SESSION_ID=
# Optional request timeout override in milliseconds (default: 120000 = 120s)
NOVELWRITER_OPENROUTER_TIMEOUT_MS=120000
